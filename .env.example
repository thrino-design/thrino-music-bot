# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#      🎵 THRINO MUSIC BOT — Environment Variables
#      Copy this to .env and fill in your values.
#      On Railway, add these in the Variables tab.
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# ── From https://my.telegram.org/apps ─────────────
API_ID=12345678
API_HASH=your_api_hash_here

# ── From @BotFather ────────────────────────────────
BOT_TOKEN=123456789:AAFxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
BOT_USERNAME=ThrinoMusicBot

# ── Your Telegram user ID (get from @userinfobot) ──
OWNER_ID=123456789

# ── Optional: extra sudo user IDs (comma-separated) ─
SUDO_USERS=

# ── Optional: support group link ──────────────────
SUPPORT_CHAT=https://t.me/yoursupportchat

# ── Optional: log channel ID (negative number) ────
LOG_CHANNEL=
